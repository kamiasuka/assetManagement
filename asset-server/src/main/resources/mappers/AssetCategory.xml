<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tedu.assetserver.mapper.AssetCategoryMapper">
    <!-- 添加分类业务 -->
    <select id="selectlistAll" resultType="cn.tedu.assetserver.pojo.vo.AssetCategoryVO">
        SELECT name,parent_id,level,type,is_parent FROM asset_category
    </select>
    <select id="selectCategoryByname" resultType="int">
        SELECT count(*) FROM asset_category WHERE name=#{name}
    </select>
    <select id="selectCategoryById" resultType="cn.tedu.assetserver.pojo.entity.AssetCategory">
        SELECT id,name,parent_id,level,type,is_parent FROM asset_category WHERE id=#{id}
    </select>
    <insert id="insertCategory">
        INSERT INTO asset_category(name,parent_id,level,type,is_parent)
        VALUES (#{name},#{parentId},#{level},#{type},#{isParent})
    </insert>
    <update id="updateParent">
        UPDATE asset_category SET
        is_parent=#{isParent}
        WHERE id=#{id}
    </update>

<!-- 修改分类业务 -->
    <select id="getStandardById" resultType="cn.tedu.assetserver.pojo.vo.CategoryStandardVO">
        SELECT name,parent_id,level,type,is_parent FROM asset_category WHERE id=#{id}
    </select>
    <select id="countByNameAndNotId" resultType="int">
        SELECT count(*) FROM asset_category  WHERE  name=#{name}
    </select>
    <update id="updateCategory">
        UPDATE asset_category
        <set>
            <if test="name!=null">name=#{name},</if>
            <if test="type!=null">asset_category.type=#{type}</if>
        </set>
        WHERE id=#{id}
    </update>

<!-- 删除分类业务 -->
    <select id="selectAssetByType" resultType="int">
        SELECT COUNT(*) FROM asset_info WHERE type=#{type}
    </select>
    <delete id="deleteCategory">
        DELETE FROM asset_category WHERE id=#{id}
    </delete>
</mapper>