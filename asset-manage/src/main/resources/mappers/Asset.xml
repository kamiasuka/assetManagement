<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tedu.asset.manage.dao.persist.mapper.AssetMapper">

    <select id="listAllCategory" resultType="java.lang.String">
        select distinct type from asset_info;
    </select>
    <select id="listAssetByCategory" resultType="cn.tedu.asset.manage.pojo.po.AssetPO">
        select *  from asset_info where type=#{type}
    </select>
    <select id="listByLevel" resultType="java.lang.String">
        select name from asset_category where level = #{level};
    </select>
    <select id="numberSumQuery" resultType="java.lang.Integer">
        select COUNT(*) from asset_info WHERE max_type = #{maxType};
    </select>
    <select id="worthSumQuery" resultType="java.lang.Double">
        select SUM(amount) from asset_info WHERE max_type = #{maxType};
    </select>
</mapper>