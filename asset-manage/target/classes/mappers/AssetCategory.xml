<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tedu.asset.manage.dao.persist.mapper.AssetCategoryMapper">
    <!-- 添加分类业务 -->
    <select id="selectListAll" resultType="cn.tedu.asset.manage.pojo.vo.AssetCategoryVO">
        SELECT name,parent_id,level,is_parent FROM asset_category
    </select>
    <select id="selectCategoryByName" resultType="int">
        SELECT count(*) FROM asset_category WHERE name=#{name}
    </select>
    <select id="selectCategoryById" resultType="cn.tedu.asset.manage.pojo.entity.AssetCategory">
        SELECT id,name,parent_id,level,is_parent FROM asset_category WHERE parent_id=#{parentId}
    </select>
    <insert id="insertCategory">
        INSERT INTO asset_category(name,parent_id,level,is_parent)
        VALUES (#{name},#{parentId},#{level},#{isParent})
    </insert>
    <update id="updateParent">
        UPDATE asset_category SET
        is_parent=#{isParent}
        WHERE id=#{id}
    </update>

<!-- 修改分类业务 -->
    <select id="getStandardById" resultType="cn.tedu.asset.manage.pojo.vo.CategoryStandardVO">
        SELECT name,parent_id,level,is_parent FROM asset_category WHERE id=#{id}
    </select>
    <select id="countByNameAndNotId" resultType="int">
        SELECT count(*) FROM asset_category  WHERE  name=#{name}
    </select>
    <update id="updateCategory">
        UPDATE asset_category
        <set>
            <if test="name!=null">name=#{name},</if>
<!--            <if test="type!=null">asset_category.type=#{type}</if>-->
        </set>
        WHERE id=#{id}
    </update>

<!-- 删除分类业务 -->
    <select id="selectAssetByName" resultType="int">
        SELECT COUNT(*) FROM asset_info WHERE name=#{name}
    </select>
    <delete id="deleteCategory">
        DELETE FROM asset_category WHERE id=#{id}
    </delete>
    <select id="countCategory" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM  asset_category WHERE parent_id=#{parent_id}
    </select>
    <update id="updateIsParent">
        UPDATE asset_category SET
            is_parent=0
        WHERE id=#{parent_id}
    </update>
</mapper>