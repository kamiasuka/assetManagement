<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tedu.asset.admin.dao.persist.mapper.UserMapper">
    <select id="getByUsername" resultType="cn.tedu.asset.admin.pojo.vo.UserVO">
        SELECT  id,username,password,identity,nickname,tel,email,dept,unit FROM asset.user WHERE username = #{username}
    </select>
    <select id="getById" resultType="cn.tedu.asset.admin.pojo.vo.UserVO">
        SELECT  id,username,password,identity,nickname,tel,email,dept,unit FROM asset.user WHERE id = #{id}
    </select>
    <update id="updateById">
        UPDATE asset.user
        <set>
            <if test="nickname != null">nickname=#{nickname},</if>
            <if test="password != null">password=#{password},</if>
            <if test="tel != null">tel=#{tel},</if>
            <if test="email != null">email=#{email},</if>
        </set>
        WHERE id=#{id}
    </update>
</mapper>
